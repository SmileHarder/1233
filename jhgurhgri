local function IsMoveOnCD(name)
	local hotbar = plr.PlayerGui.Hotbar
	if hotbar and hotbar.Backpack.Hotbar:FindFirstChild(name) then
		local button = hotbar.Backpack.Hotbar:FindFirstChild(name)
		if button.Cooldown.Visible == true then
			return true
		else
			return false
		end
	end
	return false
end

local function DoCDVisual(len, name)
	local hotbar = plr.PlayerGui.Hotbar
	if hotbar and hotbar.Backpack.Hotbar:FindFirstChild(name) then
		local button = hotbar.Backpack.Hotbar:FindFirstChild(name)
		button.Cooldown.Visible = true
		button.Cooldown.Size = UDim2.new(1, 0, -1, 0)
		game.TweenService:Create(button.Cooldown, TweenInfo.new(len, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 0, 0)}):Play()
		task.delay(len, function()
			button.Cooldown.Visible = false
		end)
	end
end

local function EmitAttachment(attachment)
	if not attachment then return end
	for _, descendant in ipairs(attachment:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			local delayTime = descendant:GetAttribute("EmitDelay") or 0
			local count = descendant:GetAttribute("EmitCount") or 1
			if delayTime > 0 then
				task.delay(delayTime, function()
					descendant:Emit(count)
				end)
			else
				descendant:Emit(count)
			end
		end
	end
end

local function PlayExistingSFX(sfx, location)
	if not sfx or not location then return end
	local sound = sfx:Clone()
	sound.Parent = location
	sound:Play()
	game.Debris:AddItem(sound, sound.TimeLength + 3)
end

local function particleAction(part)
	local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	for _, v in ipairs(part:GetDescendants()) do
		if v:IsA("ParticleEmitter") then
			task.delay(0.03, function()
				local delayTime = v:GetAttribute("EmitDelay") or 0
				local count = v:GetAttribute("EmitCount")
				if count then
					if delayTime > 0 then
						task.delay(delayTime, function()
							if v then v:Emit(count) end
						end)
					else
						v:Emit(count)
					end
				end
				game.Debris:AddItem(v, 6)
			end)
		end
	end
end

local function Skill1(char)
	if IsMoveOnCD("skill1") then CancelMove() return end
	if not HasBall() then return CancelMove() end

	local root = char.HumanoidRootPart
	local player = plr
	local character = player.Character or player.CharacterAdded:Wait()
	local humanoid = character:WaitForChild("Humanoid")

	local animation = Instance.new("Animation")
	animation.AnimationId = "rbxassetid://90781949061659"

	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	
	local function applyColor(obj, index)
		if (obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Trail")) then
			local clr
			if index % 2 == 0 then
				clr = Color3.fromRGB(0, 0, 0)
			else
				clr = Color3.fromRGB(171, 0, 0) -- red
			end

			obj.Color = ColorSequence.new(clr)
		end
	end
	
	for i, v in ipairs(game.Workspace.Effects:GetChildren()) do
		applyColor(v, i)
	end
	
	local f = game.Workspace.Effects.DescendantAdded:Connect(function(v)
		applyColor(v, 1)
	end)
	
	task.delay(1.1, function()
		f:Disconnect()
	end)

	local track = animator:LoadAnimation(animation)
	track.Priority = Enum.AnimationPriority.Action4

	track:Play()
end

local RunService = game:GetService("RunService")

local function Skill2(char:Model)
	if IsMoveOnCD("skill2") then
		CancelMove()
		return
	end

	if HasBall() then
		CancelMove()
		return
	end

	if Stunned() then
		return
	end

	local root = char:WaitForChild("HumanoidRootPart")
	local humanoid = char:WaitForChild("Humanoid")
	local targetPart = workspace.Terrain:FindFirstChild("Ball")
	if not targetPart then return end

	local savedRotation = root.CFrame - root.Position

	local heightDiff = targetPart.Position.Y - root.Position.Y
	if heightDiff < 15 then
		CancelMove()
		return
	end

	CancelMove()

	local startTime = tick()
	local timeout = 1

	local connection
	connection = RunService.RenderStepped:Connect(function()
		if not root or not targetPart then
			connection:Disconnect()
			return
		end

		if tick() - startTime >= timeout then
			connection:Disconnect()
			return
		end

		if HasBall() then
			connection:Disconnect()
			DoCDVisual(1.25, "skill2")
			local anim = Instance.new("Animation")
			anim.AnimationId = "rbxassetid://71606482166598"

			local track = humanoid:LoadAnimation(anim)

			local sound = Instance.new("Sound")
			sound.SoundId = "rbxassetid://106669508979055"
			sound.Volume = 1
			sound.Parent = SoundService
			sound:Play()
			game.Debris:AddItem(sound, 5)
			
			PlayExistingSFX(exeFolder.Tped, SoundService)
			
			for _, v in pairs(exeFolder.Exe:GetChildren()) do
				local new = v:Clone()
				
				local weld = new:FindFirstChildWhichIsA("Weld")
				weld.Part0 = char:FindFirstChild(v.Name)
				weld.Part1 = new
				
				new.Parent = char:FindFirstChild(v.Name)
				
				if new.Name == "Head" then
					for _, k in pairs(new:GetChildren()) do
						if k:IsA("Attachment") then
							k:FindFirstChild("ParticleEmitter").Enabled = true
						end
					end
				end
				
				game.Debris:AddItem(new, 0.4)
			end
			
			local highlight = Instance.new("Highlight")
			highlight.FillTransparency = 0.6
			highlight.OutlineTransparency = 0.3
			highlight.Parent = char
			game.Debris:AddItem(highlight, 0.4)
			
			TweenService:Create(highlight, TweenInfo.new(0.3), {FillTransparency = 1}):Play()
			TweenService:Create(highlight, TweenInfo.new(0.3), {OutlineTransparency = 1}):Play()

			root.Anchored = true
			root.AssemblyLinearVelocity = Vector3.zero
			humanoid.AutoRotate = false

			local camRig = game.ReplicatedStorage.Resources.blenderCam:Clone()
			camRig.Parent = game.Workspace
			camRig:PivotTo(root.CFrame * CFrame.new(0, -3, 0))
			camRig.PrimaryPart.Anchored = true
			
			cam.FieldOfView = 50
			TweenService:Create(cam, TweenInfo.new(0.3), {FieldOfView = 40}):Play()

			local camAnim = camRig.AnimationController.Animator:LoadAnimation(game.ReplicatedStorage.Resources.exe.Tpcam)
			camAnim:Play()

			cam.CameraType = Enum.CameraType.Scriptable
			local camCon = game:GetService("RunService").RenderStepped:Connect(function()
				cam.CFrame = camRig.CamPart.CFrame
			end)

			local hold
			hold = RunService.RenderStepped:Connect(function()
				if not track.IsPlaying then
					hold:Disconnect()

					cam.FieldOfView = 70
					camCon:Disconnect()
					camRig:Destroy()
					cam.CameraType = Enum.CameraType.Custom
					camRig:Destroy()
					root.Anchored = false
					root.AssemblyLinearVelocity = Vector3.zero
					humanoid.AutoRotate = true
					return
				end

				root.AssemblyLinearVelocity = Vector3.zero
			end)

			track:Play()
			return
		end

		if (targetPart.Position - root.Position).Magnitude > 10 then
			local pos = targetPart.Position
			local correctedPos = Vector3.new(pos.X, pos.Y - 4, pos.Z)

			local newCF = CFrame.new(correctedPos) * savedRotation

			root.CFrame = newCF
			RunService.RenderStepped:Wait()
			root.CFrame = newCF

			task.spawn(function()
				remote:FireServer(buffer.fromstring(buffers["grabball"]))
			end)
		end
	end)
end

