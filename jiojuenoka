local function Skill2(char)
	if IsMoveOnCD("skill2") then CancelMove() end
	if Stunned() or IsMoveOnCD("skill2") then return end
	CancelMove()

	DoCDVisual(1.5, "skill2")

	local root = char.HumanoidRootPart

	local animInst = HasBall() and dio.TP["Animation/On"] or dio.TP["Animation/Off"]
	local anim = char.Humanoid.Animator:LoadAnimation(animInst)
	anim:Play()

	local lockCon = game:GetService("RunService").RenderStepped:Connect(function()
		char.Humanoid.WalkSpeed = 0
	end)

	task.wait(0.2)

	--
	local forward = (root.CFrame - root.Position).LookVector
	local distance = 125

	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {char, game.Workspace.characters}
	rayParams.FilterType = Enum.RaycastFilterType.Blacklist

	local result = workspace:Raycast(root.Position, forward * distance, rayParams)

	if result then
		local hitPos = result.Position
		local safeOffset = forward * 2
		root.CFrame = CFrame.new(hitPos - safeOffset, hitPos - safeOffset + root.CFrame.LookVector)
	else
		root.CFrame = root.CFrame + forward * distance
	end
	--

	cam.FieldOfView = 100
	game:GetService("TweenService"):Create(cam, TweenInfo.new(0.3), {FieldOfView = 70}):Play()

	local sfx = dio.TP.SFX:Clone()
	sfx.Parent = root
	sfx:Play()
	game.Debris:AddItem(sfx, 4)

	local vfx = dio.TP.VFX:Clone()
	vfx.Parent = game.Workspace
	vfx:PivotTo(root.CFrame)

	local screenVFX = dio.TP.ColorCorrection:Clone()
	screenVFX.Name = "tpsdfjnsef"
	screenVFX.Parent = game.Lighting
	game.TweenService:Create(screenVFX, TweenInfo.new(0.12), {Brightness = 0}):Play()
	game.TweenService:Create(screenVFX, TweenInfo.new(0.12), {Saturation = 0}):Play()
	game.Debris:AddItem(screenVFX, 2)

	local parts = vfx:GetChildren()

	parts[1].Start.Transparency = 0.8
	parts[2].Start.Transparency = 0.4

	game.TweenService:Create(parts[1].Start, TweenInfo.new(0.2), {Size = Vector3.new(8.887, 22.473, 22.473), Transparency = 1, Position = parts[1].Start.Position + Vector3.new(0, -3, 0)}):Play()
	game.TweenService:Create(parts[2].Start, TweenInfo.new(0.2), {Size = Vector3.new(5.85, 16.179, 14.8), Transparency = 1, Position = parts[2].Start.Position + Vector3.new(0, -3, 0)}):Play()

	task.delay(0.5, function()
		vfx:Destroy()
	end)

	task.delay(0.3, function()
		lockCon:Disconnect()
		char.Humanoid.WalkSpeed = 40
	end)
